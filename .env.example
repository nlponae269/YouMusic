# Скопируйте в .env и заполните (используется npm run dev / seed / setup-bucket)
PORT=8080
ADMIN_TOKEN=придумайте-длинный-секрет

# PostgreSQL (Yandex Managed PostgreSQL: хост c-<cluster-id>.rw.mdb.yandexcloud.net, порт 6432)
DATABASE_URL=postgres://youmusic:password@c-xxxx.rw.mdb.yandexcloud.net:6432/youmusic
# путь к CA Яндекса: https://storage.yandexcloud.net/cloud-certs/CA.pem
PGSSLROOTCERT=./yandex-ca.pem

# Yandex Object Storage (статический ключ сервисного аккаунта)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=youmusic-tracks
S3_ACCESS_KEY_ID=YCAJ...
S3_SECRET_ACCESS_KEY=YCM...
